{
  "name": "opendex-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "wrangler types --config wrangler.types.jsonc && vite build && node scripts/inject-async-chunks.mjs",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=test-results/junit.xml",
    "deploy:cf": "pnpm build && wrangler deploy",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "check": "wrangler types --config wrangler.types.jsonc && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "gen": "wrangler types --config wrangler.types.jsonc"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "2.69.0",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "25.9.4",
    "@types/qrcode": "1.5.6",
    "jsdom": "30.0.0",
    "openapi-typescript": "7.13.0",
    "svelte": "5.56.4",
    "svelte-check": "4.7.1",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.10",
    "wrangler": "4.106.0"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0",
    "jsqr": "1.4.0",
    "lightweight-charts": "5.2.0",
    "lucide-svelte": "1.0.1",
    "openapi-fetch": "0.17.0",
    "qrcode": "1.5.4",
    "simple-icons": "16.24.1",
    "viem": "2.55.10"
  }
}
