{
  "name": "opendex-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "wrangler types --config wrangler.types.jsonc && vite build && node scripts/inject-async-chunks.mjs",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=test-results/junit.xml",
    "deploy:cf": "pnpm build && wrangler deploy",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "check": "wrangler types --config wrangler.types.jsonc && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "gen": "wrangler types --config wrangler.types.jsonc"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.21.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^25.9.1",
    "@types/qrcode": "^1.5.5",
    "jsdom": "^30.0.0",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.34.0",
    "svelte-check": "^4.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.97.0"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "bs58": "^6.0.0",
    "jsqr": "^1.4.0",
    "lightweight-charts": "^5.0.7",
    "lucide-svelte": "^1.0.1",
    "openapi-fetch": "^0.17.0",
    "qrcode": "^1.5.4",
    "simple-icons": "^16.21.0",
    "viem": "^2.55.10"
  }
}
