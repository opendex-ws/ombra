{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "waas-export-frame",
	"main": "src/entry.ts",
	"compatibility_date": "2026-07-01",
	"workers_dev": true,
	"preview_urls": false,
	"assets": { "directory": "dist", "binding": "ASSETS", "run_worker_first": true },
	"vars": {
		"EXPORT_SIGNER_PUBKEYS": ""
	}
}
